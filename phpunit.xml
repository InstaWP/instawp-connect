<?xml version="1.0" encoding="UTF-8"?>
<!--
  Unit tests for the plugin's own decisions, run against a small fake WordPress (tests/bootstrap.php).
  No WordPress install, database or network is needed.

  Run with a standalone PHPUnit phar so nothing is added to the committed vendor/:

      php /path/to/phpunit.phar

  From the monorepo, inside the instacp container where the plugin is mounted:

      docker exec instacp-server-1 bash -c 'cd /mnt/plugin-dev/instawp-connect && php /tmp/phpunit.phar'
-->
<phpunit
    bootstrap="tests/bootstrap.php"
    colors="true"
    failOnRisky="true"
    failOnWarning="true"
    displayDetailsOnTestsThatTriggerErrors="true"
    displayDetailsOnTestsThatTriggerWarnings="true"
>
    <testsuites>
        <testsuite name="instawp-connect">
            <directory>tests</directory>
        </testsuite>
    </testsuites>
</phpunit>
